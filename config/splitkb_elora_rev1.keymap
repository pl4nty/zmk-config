#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define LOWER 1

/ {

    keymap {
        compatible = "zmk,keymap";

        // The 7th column on rows 1-3 of each half is the pedal (TRRS jack) inputs.
        default_layer {
            display-name = "default";
// --------------------------------------------------------------------------------------------------------------------------------
// |   `   |  1  |  2  |  3   |  4   |  5   |      |                         |      |  6   |  7  |  8    |   9   |   0   |  DEL  |
// |  ESC  |  Q  |  W  |  E   |  R   |  T   |      |                         |      |  Y   |  U  |  I    |   O   |   P   | BKSPC |
// |  TAB  |  A  |  S  |  D   |  F   |  G   |      |                         |      |  H   |  J  |  K    |   L   |   ;   |   '   |
// | SHIFT |  Z  |  X  |  C   |  V   |  B   | MUTE |      |       |      |      |  N   |  M  |  ,    |   .   |   /   | SHIFT |
//               | GUI | ALT  | CTRL | LOWER| ENTER|                         | SPACE| LEFT |  UP | DOWN  | RIGHT |
            bindings = <
&kp GRAVE &kp N1 &kp N2   &kp N3   &kp N4    &kp N5    &none                          &none     &kp N6   &kp N7 &kp N8    &kp N9    &kp N0   &kp DEL
&kp ESC   &kp Q  &kp W    &kp E    &kp R     &kp T     &none                          &none     &kp Y    &kp U  &kp I     &kp O     &kp P    &kp BSPC
&kp TAB   &kp A  &kp S    &kp D    &kp F     &kp G     &none                          &none     &kp H    &kp J  &kp K     &kp L     &kp SEMI &kp SQT
&kp LSHFT &kp Z  &kp X    &kp C    &kp V     &kp B     &kp C_MUTE &none     &none     &none     &kp N    &kp M  &kp COMMA &kp DOT   &kp FSLH &kp RSHFT
                 &kp LGUI &kp LALT &kp LCTRL &mo LOWER &kp RET                        &kp SPACE &kp LEFT &kp UP &kp DOWN  &kp RIGHT
            >;

            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN
                &inc_dec_kp PG_UP PG_DN       &inc_dec_kp PG_UP PG_DN       &inc_dec_kp PG_UP PG_DN
            >;
        };

        lower_layer {
            display-name = "lower";
// --------------------------------------------------------------------------------------------------------------------------------
// |  BOOT |  F1 |  F2 |  F3  |  F4  |  F5  |      |                         |      |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
// |   `   |     |     |      |      |      |      |                         |      |  6   |  7    |  8    |  9   |   0   |  F12  |
// |       |     |     |      |      |  %   |      |                         |      |  ^   |  &    |  *    |  (   |   )   |   |   |
// |       |  =  |  -  |  +   |  {   |  }   |      |      |       |      |      |  [   |  ]    |  ;    |  :   |   \   |  BOOT |
//               |     |      |      |      |      |                         |      |      |       |       |      |
            bindings = <
&bootloader &kp F1    &kp F2    &kp F3      &kp F4   &kp F5    &trans                  &trans    &kp F6    &kp F7   &kp F8          &kp F9    &kp F10   &kp F11
&kp GRAVE   &none     &none     &none       &none    &none     &trans                  &trans    &kp N6    &kp N7   &kp N8          &kp N9    &kp N0    &kp F12
&trans      &none     &none     &none       &none    &kp PRCNT &trans                  &trans    &kp CARET &kp AMPS &kp KP_MULTIPLY &kp LPAR  &kp RPAR  &kp PIPE
&trans      &kp EQUAL &kp MINUS &kp KP_PLUS &kp LBRC &kp RBRC  &trans  &trans  &trans  &trans    &kp LBKT  &kp RBKT &kp SEMI        &kp COLON &kp BSLH  &bootloader
                      &trans    &trans      &trans   &trans    &trans                  &trans    &trans    &trans   &trans          &trans
            >;

            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN
                &inc_dec_kp PG_UP PG_DN       &inc_dec_kp PG_UP PG_DN       &inc_dec_kp PG_UP PG_DN
            >;
        };

    };
};
