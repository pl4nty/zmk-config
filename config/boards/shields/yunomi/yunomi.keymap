/*
 * Gboard Yunomi keymap, matching the stock firmware: each key types
 * "U+XXXX", Space, Space, Enter, which Google Japanese Input (Mozc)
 * converts to the character. The host must run Mozc / Gboard.
 *
 * Generated from chars[][] in
 * https://github.com/google/mozc-devices/blob/main/mozc-yunomi/firmware/firmware.ino
 *
 * Hold @ + + (top-left two keys) for the system layer.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/* "+" for a US host. For a JIS host use LS(SEMI), like JP_KEYBOARD in the stock firmware. */
#define UPLUS LS(EQUAL)

#define MOZC(name, a, b, c, d)                                                                     \
    name: name {                                                                                   \
        compatible = "zmk,behavior-macro";                                                         \
        #binding-cells = <0>;                                                                      \
        bindings = <&macro_tap &kp LS(U) &kp UPLUS &kp a &kp b &kp c &kp d                         \
                    &kp SPACE &kp SPACE &kp RET>;                                                  \
    };

/ {
    macros {
        MOZC(u0040, N0, N0, N4, N0) // @
        MOZC(u002b, N0, N0, N2, LS(B)) // +
        MOZC(u9c19, N9, LS(C), N1, N9) // 鰙
        MOZC(u9c73, N9, LS(C), N7, N3) // 鱳
        MOZC(u9c25, N9, LS(C), N2, N5) // 鰥
        MOZC(u9baa, N9, LS(B), LS(A), LS(A)) // 鮪
        MOZC(u9c30, N9, LS(C), N3, N0) // 鰰
        MOZC(u9c60, N9, LS(C), N6, N0) // 鱠
        MOZC(u9bdb, N9, LS(B), LS(D), LS(B)) // 鯛
        MOZC(u9bd6, N9, LS(B), LS(D), N6) // 鯖
        MOZC(u9c39, N9, LS(C), N3, N9) // 鰹
        MOZC(u9bf5, N9, LS(B), LS(F), N5) // 鯵
        MOZC(u0020, N0, N0, N2, N0) // space
        MOZC(u002d, N0, N0, N2, LS(D)) // -
        MOZC(u0021, N0, N0, N2, N1) // !
        MOZC(u9bda, N9, LS(B), LS(D), LS(A)) // 鯚
        MOZC(u002c, N0, N0, N2, LS(C)) // ,
        MOZC(u9bab, N9, LS(B), LS(A), LS(B)) // 鮫
        MOZC(u9c2d, N9, LS(C), N2, LS(D)) // 鰭
        MOZC(u9c0a, N9, LS(C), N0, LS(A)) // 鰊
        MOZC(u9c58, N9, LS(C), N5, N8) // 鱘
        MOZC(u9bf1, N9, LS(B), LS(F), N1) // 鯱
        MOZC(u9c5a, N9, LS(C), N5, LS(A)) // 鱚
        MOZC(u9c2f, N9, LS(C), N2, LS(F)) // 鰯
        MOZC(u005f, N0, N0, N5, LS(F)) // _
        MOZC(u002a, N0, N0, N2, LS(A)) // *
        MOZC(u9b5a, N9, LS(B), N5, LS(A)) // 魚
        MOZC(u9bcd, N9, LS(B), LS(C), LS(D)) // 鯍
        MOZC(u9b77, N9, LS(B), N7, N7) // 魷
        MOZC(u9be5, N9, LS(B), LS(E), N5) // 鯥
        MOZC(u9c24, N9, LS(C), N2, N4) // 鰤
        MOZC(u9c56, N9, LS(C), N5, N6) // 鱖
        MOZC(u9c41, N9, LS(C), N4, N1) // 鱁
        MOZC(u9c78, N9, LS(C), N7, N8) // 鱸
        MOZC(u9be8, N9, LS(B), LS(E), N8) // 鯨
        MOZC(u9c3b, N9, LS(C), N3, LS(B)) // 鰻
        MOZC(u003d, N0, N0, N3, LS(D)) // =
        MOZC(u002f, N0, N0, N2, LS(F)) // /
        MOZC(u003f, N0, N0, N3, LS(F)) // ?
        MOZC(u9c7a, N9, LS(C), N7, LS(A)) // 鱺
        MOZC(u002e, N0, N0, N2, LS(E)) // .
        MOZC(u9bb4, N9, LS(B), LS(B), N4) // 鮴
        MOZC(u9b83, N9, LS(B), N8, N3) // 鮃
        MOZC(u9bf0, N9, LS(B), LS(F), N0) // 鯰
        MOZC(u9bf3, N9, LS(B), LS(F), N3) // 鯳
        MOZC(u9bac, N9, LS(B), LS(A), LS(C)) // 鮬
        MOZC(u9b5d, N9, LS(B), N5, LS(D)) // 魝
        MOZC(u9c4f, N9, LS(C), N4, LS(F)) // 鱏
        MOZC(u9ba8, N9, LS(B), LS(A), N8) // 鮨
        MOZC(u8336, N8, N3, N3, N6) // 茶
        MOZC(u9c77, N9, LS(C), N7, N7) // 鱷
        MOZC(u9b6f, N9, LS(B), N6, LS(F)) // 魯
        MOZC(u9c29, N9, LS(C), N2, N9) // 鰩
        MOZC(u9b79, N9, LS(B), N7, N9) // 魹
        MOZC(u9bd4, N9, LS(B), LS(D), N4) // 鯔
        MOZC(u9b76, N9, LS(B), N7, N6) // 魶
        MOZC(u9c0c, N9, LS(C), N0, LS(C)) // 鰌
        MOZC(u9bfc, N9, LS(B), LS(F), LS(C)) // 鯼
        MOZC(u9bc9, N9, LS(B), LS(C), N9) // 鯉
        MOZC(u9c27, N9, LS(C), N2, N7) // 鰧
    };

    combos {
        compatible = "zmk,combos";
        combo_sys {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&mo 1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Fish";
            // @  +  鰙  鱳  鰥  鮪  鰰  鱠  鯛  鯖  鰹  鯵
            // ␣  -  !  鯚  ,  鮫  鰭  鰊  鱘  鯱  鱚  鰯
            // _  *  魚  鯍  魷  鯥  鰤  鱖  鱁  鱸  鯨  鰻
            // =  /  ?  鱺  .  鮴  鮃  鯰  鯳  鮬  魝  鱏
            // 鮨  茶  鱷  魯  鰩  魹  鯔  魶  鰌  鯼  鯉  鰧
            bindings = <
&u0040 &u002b &u9c19 &u9c73 &u9c25 &u9baa &u9c30 &u9c60 &u9bdb &u9bd6 &u9c39 &u9bf5
&u0020 &u002d &u0021 &u9bda &u002c &u9bab &u9c2d &u9c0a &u9c58 &u9bf1 &u9c5a &u9c2f
&u005f &u002a &u9b5a &u9bcd &u9b77 &u9be5 &u9c24 &u9c56 &u9c41 &u9c78 &u9be8 &u9c3b
&u003d &u002f &u003f &u9c7a &u002e &u9bb4 &u9b83 &u9bf0 &u9bf3 &u9bac &u9b5d &u9c4f
&u9ba8 &u8336 &u9c77 &u9b6f &u9c29 &u9b79 &u9bd4 &u9b76 &u9c0c &u9bfc &u9bc9 &u9c27
            >;
        };

        sys_layer {
            display-name = "System";
            bindings = <
&trans &trans &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &bt BT_CLR &out OUT_TOG &trans &bootloader &sys_reset
&trans &trans &trans       &trans       &trans       &trans       &trans       &trans      &trans        &trans &trans      &trans
&trans &trans &trans       &trans       &trans       &trans       &trans       &trans      &trans        &trans &trans      &trans
&trans &trans &trans       &trans       &trans       &trans       &trans       &trans      &trans        &trans &trans      &trans
&trans &trans &trans       &trans       &trans       &trans       &trans       &trans      &trans        &trans &trans      &trans
            >;
        };
    };
};
